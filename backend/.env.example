MONGO_URL=mongodb://localhost:27017
DB_NAME=netpresence
LOG_LEVEL=INFO
# Secret the teacher app/dashboard sends as X-Teacher-Token. CHANGE THIS.
TEACHER_TOKEN=change-me
# v1 acoustic
TOKEN_VALIDITY_SECONDS=60
# v2 proximity graph defaults (per-session overridable)
WINDOW_SECONDS=20
DISCOVERY_TAIL_SECONDS=5
REPORT_GRACE_SECONDS=10
RSSI_REF_DBM=-59
PATH_LOSS_N=3.0
# edge threshold is density-adaptive unless set per session (2.0 m for >=70 check-ins, 2.5 m for 50-69, 3.0 m below)
MAX_EDGE_M=2.0
TTL_HOPS=8
MAX_PATH_M=15
K_WITNESS=2
AGREE_DELTA_DB=8
NEAR_M=0
NEAR_K=1
INDEPENDENT=1
AUTOCAL=1
# Relay/Sybil defence: ids whose readings at the common observers differ by less than this many dB (robust sd) are one radio
# and are flagged for the teacher instead of being admitted. 0 switches it off.
COLOCATION_DB=2.5
# Optional class code required to enrol a phone (tell the class in person). Empty = off.
ENROL_CODE=
