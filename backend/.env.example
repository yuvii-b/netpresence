MONGO_URL=mongodb://localhost:27017
DB_NAME=netpresence
LOG_LEVEL=INFO
# Secret the teacher app/dashboard sends as X-Teacher-Token. CHANGE THIS.
TEACHER_TOKEN=change-me
# v1 acoustic
TOKEN_VALIDITY_SECONDS=60
# v2 proximity graph defaults (per-session overridable)
WINDOW_SECONDS=45
REPORT_GRACE_SECONDS=15
RSSI_REF_DBM=-59
PATH_LOSS_N=3.0
MAX_EDGE_M=2.0
TTL_HOPS=8
MAX_PATH_M=15
K_WITNESS=2
AGREE_DELTA_DB=8
